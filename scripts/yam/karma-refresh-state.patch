+                clock[0] += 1.0  # simulate HTTP latency without sleeping
+                if telemetry_stops:
+                    arm.age_s = 5.0
+                return TeleopStep(targets={"left": target()}, event=EpisodeEvent.START)
+            if self.calls == 2:
+                return TeleopStep(event=EpisodeEvent.SAVE)
+            return TeleopStep(event=EpisodeEvent.STOP)
+
+    result = record_session(
+        arms={"left": arm}, source=BlockingSource(), sink=sink, task="test",
+        fps=1000, refresh_states_after_poll=refresh, report=lambda message: None,
+    )
+    expected = int(refresh and not telemetry_stops)
+    assert result.frames == expected
+    assert len(arm.commands) == expected
